# Copy this file to .env.local and fill in real values. Never commit .env.local.
# On Vercel, set the same three variables in Project -> Settings -> Environment Variables.

# The FastAPI backend, including /api/v1. Locally: http://localhost:8000/api/v1
# Deployed: your Render URL, e.g. https://billsplit-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase -> Project Settings -> API. The anon / publishable key is meant to be
# public (it ships to browsers); row level security keeps the data private.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
