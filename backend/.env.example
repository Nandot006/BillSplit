# Copy to backend/.env and fill in real values. Never commit .env.

# Supabase -> Connect. For local dev either string works; on Render use the
# "Session pooler" string (port 5432) - the direct host is IPv6-only.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase -> Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only if your project still uses the legacy JWT secret (Settings -> JWT Keys).
# Leave empty if it uses the newer asymmetric signing keys.
SUPABASE_JWT_SECRET=

# Claude API (console.anthropic.com) - reads receipts and tags items.
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-5-5

# Browser origins allowed to call this API, comma-separated.
CORS_ORIGINS=http://localhost:3000

ENV=dev
